# Copy this file to local.env and edit it.
# local.env is gitignored — put your personal settings here instead of
# editing config.sh directly, so git pull never conflicts.

# PANEL=regular         # regular or rev6
# RAM_TYPE=DDR4         # DDR4 or DDR3
# HOSTNAME=rg35xxh
# TIMEZONE=Asia/Jakarta
# ROOT_PASSWORD=root
# DEFAULT_USER=alpine
# DEFAULT_PASSWORD=alpine
# DEFAULT_USER_WHEEL=true
# ENABLE_SSH=true
# MAKE_GZ_IMAGE=true    # set to false to skip xz compression (faster iteration)
# SWP_PART=             # swap partition size e.g. 512M or 2G; created at first boot, not baked into image

# Wi-Fi baked into the image (joined automatically on first boot).
# The passphrase is stored in plaintext inside the .img: don't share the image.
# Quote values containing spaces or symbols.
# WIFI_SSID=
# WIFI_PSK=
# true for a hidden network
# WIFI_HIDDEN=false
